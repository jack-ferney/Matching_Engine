# Matches the existing style: 4-space indent, attached braces, 100-col, left-aligned
# pointers/refs. Run `clang-format -i` over src/ include/ apps/ bench/ tests/ to apply.
---
Language: Cpp
BasedOnStyle: Google
IndentWidth: 4
ColumnLimit: 100
PointerAlignment: Left
AccessModifierOffset: -4
AllowShortFunctionsOnASingleLine: Inline
AllowShortBlocksOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: false
SortIncludes: false
SpaceBeforeParens: ControlStatements
---
